generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  landlord
  tenant
}

enum AccountStatus {
  active
  pending_verification
  deactivated
  deleted
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phoneNumber  String?    @unique
  passwordHash String
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  role         Role       @default(tenant)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  verificationCode String?
  verificationToken String?
  verificationCodeExpiry DateTime?
  verificationTokenExpiry DateTime?
  verificationAttempts Int @default(0)
  resendAttempts Int      @default(0)
  lastVerificationSentAt DateTime?
  verificationMethod String?
  accountStatus AccountStatus @default(active)
  deactivatedAt DateTime?
  scheduledDeletionDate DateTime?
  properties   Property[] @relation("PropertyOwner")
  blogPosts    Blog[]     @relation("BlogAuthor")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([passwordResetTokenHash])
  @@index([accountStatus])
  @@index([verificationToken])
  @@index([scheduledDeletionDate])
}

model Property {
  id          String          @id @default(uuid())
  title       String
  description String          @db.Text
  price       Decimal         @db.Decimal(10, 2)
  location    String
  ownerId     String
  owner       User            @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  images      PropertyImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
  @@index([createdAt])
}

model PropertyImage {
  id                 String   @id @default(uuid())
  url                String
  cloudinaryPublicId String   @unique
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@index([propertyId])
}

model Blog {
  id            String   @id @default(uuid())
  title         String
  content       String   @db.Text
  imageUrl      String?
  imagePublicId String?  @unique
  authorId      String
  author        User     @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}
